<?php

/**
 * @file
 * TMWB PCB and Wiring Tools module.
 */

/**
 * Implements hook_theme().
 *
 * Registers the Twig template that renders the tool's mount point and its
 * server-rendered description.
 */
function tmwb_pcb_wiring_theme($existing, $type, $theme, $path) {
  return [
    'tmwb_pcb_wiring' => [
      'variables' => [
        'heading' => 'h2',
        'features' => [],
        'show_description' => TRUE,
      ],
      'template' => 'tmwb-pcb-wiring',
    ],
  ];
}
